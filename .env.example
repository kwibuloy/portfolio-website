# Copy to .env.local and fill in real values. Never commit .env.local.

# Inbox that receives contact form messages (server-only)
CONTACT_TO_EMAIL=

# Email service API key (server-only, never NEXT_PUBLIC_)
RESEND_API_KEY=

# GitHub personal access token for the contribution graph (server-only).
# Fine-grained, "Public repositories" access, no permissions.
GITHUB_TOKEN=

# Upstash Redis: the visitor counter and rate limiting (server-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

VISITOR_SALT=
